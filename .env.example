# ==============================================================================
# Veritas — Configuration & Environment Variables
# ==============================================================================

# Core Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding Backend
# Options: "tfidf" (zero-dependency, offline default) or "openai"
EMBEDDING_BACKEND=tfidf

# LLM Provider
# Options: "mock" (offline extractive stitcher default), "openai", or "anthropic"
LLM_PROVIDER=mock

# Model Names (Placeholder - No dated snapshots hardcoded)
# For OpenAI models see: https://platform.openai.com/docs/models
OPENAI_MODEL_NAME=your-openai-model-name-here
# For OpenAI embedding models see: https://platform.openai.com/docs/guides/embeddings
OPENAI_EMBEDDING_MODEL_NAME=your-openai-embedding-model-name-here

# For Anthropic models see: https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL_NAME=your-anthropic-model-name-here

# Optional API Keys (Leave empty when running offline with mock & tfidf)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chunking Parameters
CHUNK_SIZE_TARGET=400
CHUNK_OVERLAP=60

# Hybrid Retrieval Parameters
RETRIEVAL_DENSE_TOP_K=10
RETRIEVAL_BM25_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RRF_K=60

# Storage & Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
CHROMA_PERSIST_DIR=data/processed/chroma
BM25_INDEX_PATH=data/processed/bm25_index.pkl
TFIDF_MODEL_PATH=data/processed/tfidf_vectorizer.pkl
CHUNKS_METADATA_PATH=data/processed/chunks_metadata.jsonl

# CORS Configuration
# Comma-separated list of additional allowed browser origins.
# http://localhost:3000 and http://127.0.0.1:3000 are always permitted by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
